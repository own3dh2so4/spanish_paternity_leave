{
    "name": "spanish-paternity-leave",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
        "lint": "eslint src e2e/tests e2e/page-objects e2e/utils",
        "lint:fix": "eslint src e2e/tests e2e/page-objects e2e/utils --fix",
        "format": "prettier --write src",
        "test": "vitest",
        "test:run": "vitest run",
        "test:e2e": "npm --prefix e2e run test:e2e",
        "format:check": "prettier --check src"
    },
    "dependencies": {
        "date-fns": "^4.4.0",
        "lz-string": "^1.5.0",
        "react": "^19.2.8",
        "react-datepicker": "^9.1.0",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.12.0",
        "jsdom": "^30.0.1",
        "prettier": "^3.9.6",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.2.2",
        "vitest": "^5.0.0"
    }
}
